{
  "extends": "@barberflow/tsconfig/nextjs.json",
  "compilerOptions": {
    "outDir": "./dist",
    "exactOptionalPropertyTypes": false,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}

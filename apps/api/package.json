{
  "name": "@barberflow/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "test:integration": "vitest run --reporter=verbose test/tenant-isolation.spec.ts test/whatsapp/whatsapp-webhook.spec.ts test/bot/bot-conversation.spec.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@barberflow/db": "workspace:*",
    "@barberflow/shared-types": "workspace:*",
    "@clerk/backend": "^1.3.0",
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@prisma/client": "^5.16.0",
    "@nestjs/bullmq": "^10.2.0",
    "bullmq": "^5.12.0",
    "class-transformer": "^0.5.1",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.1.3",
    "class-validator": "^0.14.0",
    "ioredis": "^5.4.0",
    "nestjs-pino": "^4.1.0",
    "@nestjs/throttler": "^6.2.0",
    "helmet": "^8.0.0",
    "stripe": "^16.0.0",
    "pino": "^9.3.0",
    "pino-http": "^10.2.0",
    "pino-pretty": "^11.2.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@barberflow/tsconfig": "workspace:*",
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.3.0",
    "@types/express": "^4.17.0",
    "@types/supertest": "^6.0.0",
    "supertest": "^7.0.0",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "dotenv": "^16.4.0",
    "eslint": "^9.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}

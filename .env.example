# ============================================================
# BarberFlow — Variables de entorno
# Copia este archivo a .env y completa los valores reales.
# NUNCA commitees el archivo .env.
# ============================================================

# ----- Base de datos ----------------------------------------
# URL de conexión principal (con pgBouncer/pool para Prisma)
DATABASE_URL="postgresql://barberflow:password@localhost:5432/barberflow?schema=public"
# URL directa para migraciones (sin pool)
DIRECT_DATABASE_URL="postgresql://barberflow:password@localhost:5432/barberflow?schema=public"

# ----- Redis ------------------------------------------------
REDIS_URL="redis://localhost:6379"

# ----- API --------------------------------------------------
NODE_ENV="development"
PORT=3001
API_URL="http://localhost:3001"
DASHBOARD_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"

# ----- Clerk (auth dashboard) --------------------------------
# Obtener en: https://dashboard.clerk.com
CLERK_SECRET_KEY="sk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# ----- WhatsApp Business Cloud API (Meta) -------------------
# Obtener en: https://developers.facebook.com
WHATSAPP_APP_ID="XXXXXXXXXXXXXXX"
WHATSAPP_APP_SECRET="XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
WHATSAPP_VERIFY_TOKEN="your-random-verify-token-here"
WHATSAPP_API_VERSION="v20.0"
# Access token de larga duración del sistema
WHATSAPP_ACCESS_TOKEN="EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ----- Stripe -----------------------------------------------
# Obtener en: https://dashboard.stripe.com
STRIPE_SECRET_KEY="your-stripe-secret-key-here"
STRIPE_WEBHOOK_SECRET="your-stripe-webhook-secret-here"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="your-stripe-publishable-key-here"

# ----- Sentry (observabilidad) ------------------------------
SENTRY_DSN="https://xxxx@xxxx.ingest.sentry.io/xxxx"
SENTRY_ENVIRONMENT="development"

# ----- Testing (no usar en producción) ----------------------
TEST_DATABASE_URL="postgresql://barberflow:password@localhost:5433/barberflow_test"
